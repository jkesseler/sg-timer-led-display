{
  "name": "score-keeping-ble-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Software ESP32: relays BLE shot timer events to MQTT using the firmware's topic contract",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0",
    "dotenv": "17.4.2",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "usb@2.18.0": true,
    "@stoprocent/noble@2.8.0": false,
    "@stoprocent/bluetooth-hci-socket@2.3.0": false,
    "@serialport/bindings-cpp@12.0.1": false
  }
}
