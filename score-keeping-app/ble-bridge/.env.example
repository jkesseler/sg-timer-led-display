MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Required. The ID this bridge publishes under (timer/<id>/...); register it as a device in Payload admin.
BRIDGE_DEVICE_ID=

# Optional: only connect to a timer whose advertised name contains this text (case-insensitive).
TIMER_NAME_FILTER=
# Optional: only connect to the timer with this BLE address, e.g. f4:12:34:56:78:9a.
TIMER_ADDRESS=
