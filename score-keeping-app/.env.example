PAYLOAD_SECRET=YOUR_SECRET_HERE
# Browser connection to the MQTT broker (WebSocket). Leave unset to use
# ws://<host the page was loaded from>:9001 — the only value that works for
# both the laptop and a TV opening http://<laptop>:3000/display.
# MQTT_WS_URL=ws://broker.example:9001
MQTT_USERNAME=
MQTT_PASSWORD=